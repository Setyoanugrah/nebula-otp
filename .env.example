# SMTP (email channel) — works with Gmail app password, Mailgun, Brevo, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS gateway — an Android SMS-gateway app on a phone with a SIM, or an aggregator
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# WhatsApp gateway (optional)
WA_URL=
WA_TOKEN=

# service
OTP_DB=/var/lib/otpsvc/otp.db
OTP_TTL=300
OTP_COOLDOWN=60
OTP_MAX_ATTEMPTS=5
OTP_DAILY_QUOTA=200
OTP_ADMIN_TOKEN=change-me
OTP_DEV_MODE=0
PORT=8099
